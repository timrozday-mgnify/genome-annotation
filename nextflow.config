/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    nf-core/genomeannotation Nextflow config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Default config options for all compute environments
----------------------------------------------------------------------------------------
*/

manifest {
    name            = 'nf-core/genomeannotation'
    author          = '@timrozday-mgnify'
    homePage        = 'https://github.com/timrozday-mgnify/genome-annotation'
    description     = 'Simple functional annotation of genomes'
    mainScript      = 'main.nf'
    defaultBranch   = 'master'
    nextflowVersion = '!>=24.10.5'
    version         = '1.0.0dev'
}

plugins {
    id 'nf-amazon@2.9.2'
    id 'nf-schema@2.2.0'
}

nextflow.enable.strict = true

params {
    input = null
    outdir = "results"
    publish_dir_mode = 'copy'
    singularity_cachedir = "singularity_cache"
    trace_report_suffix = ""
    modules_testdata_base_path = 'https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/'
    pipelines_testdata_base_path = 'https://raw.githubusercontent.com/nf-core/test-datasets/refs/heads/genomeannotation'

    prodigal_meta = false
    pfam_chunksize = 2097152
    kofam_chunksize = 2097152
    dbcan_chunksize = 1048576

    run_gapseq      = false
    gapseq_medium   = ''

    run_carveme     = false
    carveme_mediadb = ''

    run_pyrodigal   = true

    run_pfam        = true
    run_dbcan       = true
    run_kofam       = true

    // --- DBS
    databases {
        pfam {
            hmm      = ''
            n_profiles = 24736
        }
        dbcan {
            files {
                db = ''
            }
        }
        kofam_chunked {
            chunk_1 {
                files {
                    ko_list = ''
                    profiles = ''
                }
            }
        }
        gapseq {
            path = ''
        }
    }
}

apptainer.registry = 'quay.io'
docker.registry = 'quay.io'
podman.registry = 'quay.io'
singularity.registry = 'quay.io'
charliecloud.registry = 'quay.io'

// Disable process selector warnings by default.
nextflow.enable.configProcessNamesValidation = false

validation {
    help {
        enabled             = true
        beforeText          = "\n-- genome-annotation -------------------------------------------------\n"
        afterText           = "\n--------------------------------------------------------------------\n"
        showHidden          = false
        command             = 'nextflow run main.nf -profile docker,local --input samplesheet.csv --outdir results'
        fullParameter       = 'help_full'
        showHiddenParameter = 'show_hidden'
    }
    summary {
        beforeText = "\n-- genome-annotation -------------------------------------------------\n"
        afterText  = "\n--------------------------------------------------------------------\n"
    }
}

timeline {
    enabled = true
    file = "${params.outdir}/pipeline_info/execution_timeline${params.trace_report_suffix}.html"
    overwrite = true
}
report {
    enabled = true
    file = "${params.outdir}/pipeline_info/execution_report${params.trace_report_suffix}.html"
    overwrite = true
}
trace {
    enabled = true
    file = "${params.outdir}/pipeline_info/execution_trace${params.trace_report_suffix}.txt"
    overwrite = true
}
dag {
    enabled = true
    file = "${params.outdir}/pipeline_info/pipeline_dag${params.trace_report_suffix}.html"
    overwrite = true
}


// Load the base config: the `process_single/low/medium/high` labels the modules
// carry. Included before `profiles` so the site profiles still override it.
includeConfig 'conf/base.config'

profiles {
    docker {
        docker {
            enabled    = true
            registry   = ''
            runOptions = '--platform linux/amd64 --entrypoint ""'
        }
    }

    singularity {
        singularity {
            enabled = true
            autoMounts = true
            cacheDir = params.singularity_cachedir
        }
    }

    local {
        includeConfig 'conf/local.config'
    }

    codon {
        includeConfig 'conf/codon.config'
    }

    test {
        includeConfig 'conf/test.config'
    }
}

includeConfig 'conf/modules.config'
